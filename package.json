{
  "name": "als-oracle-pathfinder",
  "private": true,
  "description": "An Account Lookup Service Oracle using GSMA PathFinder for resolution of MSISDNs",
  "version": "12.3.5",
  "license": "Apache-2.0",
  "author": "Matt Kingston <matt.kingston@modusbox.com>",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git://github.com/mojaloop/als-oracle-pathfinder.git"
  },
  "bugs": "http://github.com/mojaloop/als-oracle-pathfinder/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": "22.x"
  },
  "ava": {
    "timeout": "30s"
  },
  "main": "./src/index.js",
  "dependencies": {
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "@lib/pathfinder": "file:src/lib/pathfinder",
    "@mojaloop/central-services-logger": "11.10.6",
    "@mojaloop/central-services-shared": "18.38.2",
    "dotenv": "17.4.2",
    "knex": "3.3.0",
    "mysql2": "3.23.4"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "ava": "8.0.1",
    "eslint": "10.8.1",
    "npm-audit-resolver": "3.0.0-RC.0",
    "npm-check-updates": "23.0.2",
    "nyc": "^18.0.0",
    "pre-commit": "2.0.0",
    "replace": "^1.2.2",
    "sinon": "^22.1.0",
    "standard": "^17.1.2",
    "standard-version": "^9.5.0",
    "tap-xunit": "2.4.1"
  },
  "overrides": {
    "form-data": "4.0.6",
    "on-headers": "1.1.0",
    "@eslint/plugin-kit": "0.6.1",
    "@mojaloop/central-services-shared": {
      "@mojaloop/central-services-logger": "11.10.6"
    },
    "cross-spawn": "7.0.6",
    "standard": {
      "json5": "2.2.2"
    },
    "shins": {
      "ejs": "3.1.10",
      "sanitize-html": "2.12.1",
      "jsonpointer": "5.0.0",
      "markdown-it": "12.3.2",
      "postcss": "8.4.31"
    },
    "widdershins": {
      "markdown-it": "12.3.2",
      "swagger2openapi": "7.0.8"
    },
    "yargs-parser": "21.1.1",
    "tough-cookie": "4.1.3",
    "got": "11.8.5",
    "validator": "13.15.26",
    "js-yaml": "4.3.1",
    "qs": "6.15.3",
    "axios": "1.19.0",
    "fast-xml-parser": "5.5.7",
    "undici": "6.24.1",
    "immutable": "5.1.9",
    "minimatch": "10.2.4",
    "@babel/core": "7.29.7",
    "@grpc/grpc-js": "1.14.4",
    "@protobufjs/utf8": "1.1.2",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "convict": "6.2.5",
    "fast-uri": "3.1.5",
    "follow-redirects": "1.16.0",
    "handlebars": "4.7.9",
    "js-yaml@4": "4.3.1",
    "lodash": "4.18.1",
    "picomatch@2": "2.3.2",
    "protobufjs": "8.7.2",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "@babel/helpers": "7.29.7",
    "flatted": "3.4.4",
    "minimatch@3": "3.1.5",
    "minimatch@9": "9.0.9",
    "picomatch@4": "4.0.5",
    "ajv@6": "6.14.0",
    "brace-expansion@3": "3.0.2",
    "brace-expansion@4": "4.0.2"
  },
  "scripts": {
    "build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/als-oracle-pathfinder -f ./Dockerfile .",
    "lint": "npx standard",
    "lint:fix": "npx standard --fix",
    "regenerate": "yo swaggerize:test --framework hapi --apiPath './src/swagger.json'",
    "start": "node --unhandled-rejections=strict ./src/index",
    "test": "PATHFINDER_REJECT_UNAUTHORIZED=true npm run test:unit",
    "test:unit": "npx ava --no-worker-threads --serial ./test/unit/**/*.test.js",
    "test:xunit": "npm run test:unit -- --tap | tap-xunit > ./test/results/xunit.xml",
    "test:coverage-check": "nyc ava --no-worker-threads --serial ./test/unit/**/*.test.js",
    "test:pathfinder": "ava ./src/lib/pathfinder/test/unit/**/*.test.js",
    "test:functional": "echo 'No functional tests defined'",
    "test:integration": "echo 'No integration tests defined'",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "audit:resolve": "resolve-audit --production",
    "audit:fix": "npm audit fix",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "release": "npx standard-version --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'"
  },
  "pre-commit": [
    "lint",
    "dep:check",
    "audit:check",
    "test",
    "test:coverage-check"
  ],
  "generator-swaggerize": {
    "version": "4.1.0"
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md"
    }
  }
}
